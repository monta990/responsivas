msgid "Used when the computer has an invoice and supplier. Variables: {fecha_compra}, {factura}, {proveedor}. Empty uses the default text."
msgstr "Utilizzato quando il computer ha una fattura e un fornitore. Variabili: {fecha_compra}, {factura}, {proveedor}. Se vuoto, viene utilizzato il testo predefinito."
msgid "Used when the computer has no registered invoice or supplier. Empty uses the default text."
msgstr "Utilizzato quando il computer non ha una fattura o un fornitore registrati. Se vuoto, viene utilizzato il testo predefinito."
msgid "The useful life clause is inserted automatically; use {clausula_vida_util} to control its position."
msgstr "La clausola sulla vita utile viene inserita automaticamente; utilizzare {clausula_vida_util} per controllarne la posizione."
