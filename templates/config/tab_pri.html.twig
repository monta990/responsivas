<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-printer', title: trans('Printer responsibility document settings')} %}
    <div class="card-body">

        <div class="row mt-3">
            <div class="col-md-6 mb-3">
                <div class="form-label fw-bold d-flex align-items-center gap-1">
                    <i class="ti ti-text-wrap"></i> {{ trans('Font used') }}
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="ti ti-typography"></i></span>
                    <input type="text" class="form-control bg-body text-body" name="pri_pdf_font_display" value="{{ pdf_font }}" readonly>
                </div>
                <div class="form-text">{{ trans('Font used in PDFs, can be changed in GLPI settings') }}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold d-flex align-items-center gap-1" for="pri_font_size">
                    <i class="ti ti-arrows-vertical"></i> {{ trans('Font size (pt)') }}
                </label>
                <div class="input-group">
                    <span class="input-group-text"><i class="ti ti-text-size"></i></span>
                    <input type="number" class="form-control" id="pri_font_size" name="pri_font_size"
                           value="{{ config.pri_font_size ?? 10 }}" min="6" max="24">
                </div>
                <div class="form-text">{{ trans('Enter the font size for the PDF') }}</div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="form-label fw-bold d-flex align-items-center">
                <i class="ti ti-writing-sign me-2"></i>{{ trans('Show lender/borrower signatures') }}
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox"
                       id="pri_show_comodato_sigs" name="pri_show_comodato_sigs" value="1"
                       {{ config.pri_show_comodato_sigs ? 'checked' : '' }}>
                <label class="form-check-label" for="pri_show_comodato_sigs">
                    {{ trans('Show both lender and borrower signature lines in printer responsibility document') }}
                </label>
            </div>
            <div class="form-text">{{ trans('Uses the legal representative configured in General settings.') }}</div>
        </div>

        <div class="row">
            {% include 'partials/footer_fields.html.twig' with {prefix: 'pri', config: config} %}
        </div>

    </div>
</div>


<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-file-text', title: trans('Document template')} %}
    <div class="card-body">

        {% include 'partials/variable_hints.html.twig' with {vars: {
            '{nombre}':       trans('Full name of the assigned user'),
            '{empresa}':      trans('Company'),
            '{num_empleado}': trans('Employee number'),
            '{activo}':       trans('Asset number'),
            '{serie}':        trans('Serial number'),
            '{marca}':        trans('Brand'),
            '{modelo}':       trans('Model'),
            '{tipo}':         trans('Type'),
            '{estado}':       trans('Condition / Status'),
            '{fecha}':        trans('Document date'),
            '{lugar}':        trans('City, State, Country')
        }} %}

        {% include 'partials/template_editor.html.twig' with {
            label: trans('Document title'), name: 'pri_titulo',
            value: pri_titulo_v, hint: trans('Main heading text. Use **text** for bold.'), rows: 1
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Introduction paragraph'), name: 'pri_intro',
            value: pri_intro_v, hint: trans('Introductory paragraph before the table. Use **text** for bold.'), rows: 3
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Body / Clauses'), name: 'pri_cuerpo',
            value: pri_cuerpo_v, hint: trans('Legal text after the table. Lines with "1. text" → numbered list. Blank line → new paragraph. **text** → bold.'), rows: 10
        } %}

    </div>
</div>

<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-clipboard-text', title: trans('Inspection and return form templates') } %}
    <div class="card-body">
        <div class="fw-bold mb-2 d-flex align-items-center gap-2">
            <i class="ti ti-clipboard-check"></i>{{ trans('Manual forms') }}
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pri_enable_visual_inspection" name="pri_enable_visual_inspection" value="1" {{ config.pri_enable_visual_inspection ? 'checked' : '' }}>
                    <label class="form-check-label fw-bold" for="pri_enable_visual_inspection">{{ trans('Enable visual inspection form') }}</label>
                </div>
                <div class="form-text">{{ trans('Shows the Visual condition button below Printers. The PDF is fixed and designed to be completed by hand.') }}</div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pri_enable_return_form" name="pri_enable_return_form" value="1" {{ config.pri_enable_return_form ? 'checked' : '' }}>
                    <label class="form-check-label fw-bold" for="pri_enable_return_form">{{ trans('Enable return form') }}</label>
                </div>
                <div class="form-text">{{ trans('Shows the Return button below Printers. The PDF is fixed and designed to be completed by hand.') }}</div>
            </div>
        </div>

        <hr class="my-3">

        <div class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="ti ti-file-text"></i>{{ trans('Manual form templates') }}
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <h5 class="mb-3">{{ trans('Visual condition form') }}</h5>
                {% include 'partials/template_editor.html.twig' with {
                    label: trans('Title'), name: 'pri_inspection_title',
                    value: config.pri_inspection_title,
                    hint: trans('Title printed in the fixed manual PDF.'), rows: 1
                } %}
                {% include 'partials/template_editor.html.twig' with {
                    label: trans('Instructions'), name: 'pri_inspection_instructions',
                    value: config.pri_inspection_instructions,
                    hint: trans('Text printed above the handwritten observation area. Use **text** for bold.'), rows: 4
                } %}
                <div class="mt-3 pt-3 border-top">
                    <div class="fw-bold mb-2">{{ trans('Document footer') }}</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Top left'), name: 'pri_inspection_footer_left_1',
                                value: config.pri_inspection_footer_left_1,
                                hint: trans('Upper-left footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Top right'), name: 'pri_inspection_footer_right_1',
                                value: config.pri_inspection_footer_right_1,
                                hint: trans('Upper-right footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Bottom left'), name: 'pri_inspection_footer_left_2',
                                value: config.pri_inspection_footer_left_2,
                                hint: trans('Lower-left footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Bottom right'), name: 'pri_inspection_footer_right_2',
                                value: config.pri_inspection_footer_right_2,
                                hint: trans('Lower-right footer line.'), rows: 1
                            } %}
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-lg-6">
                <h5 class="mb-3">{{ trans('Return form') }}</h5>
                {% include 'partials/template_editor.html.twig' with {
                    label: trans('Title'), name: 'pri_return_title',
                    value: config.pri_return_title,
                    hint: trans('Title printed in the fixed manual PDF.'), rows: 1
                } %}
                {% include 'partials/template_editor.html.twig' with {
                    label: trans('Instructions'), name: 'pri_return_instructions',
                    value: config.pri_return_instructions,
                    hint: trans('Text printed above the handwritten observation area. Use **text** for bold.'), rows: 4
                } %}
                <div class="mt-3 pt-3 border-top">
                    <div class="fw-bold mb-2">{{ trans('Document footer') }}</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Top left'), name: 'pri_return_footer_left_1',
                                value: config.pri_return_footer_left_1,
                                hint: trans('Upper-left footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Top right'), name: 'pri_return_footer_right_1',
                                value: config.pri_return_footer_right_1,
                                hint: trans('Upper-right footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Bottom left'), name: 'pri_return_footer_left_2',
                                value: config.pri_return_footer_left_2,
                                hint: trans('Lower-left footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Bottom right'), name: 'pri_return_footer_right_2',
                                value: config.pri_return_footer_right_2,
                                hint: trans('Lower-right footer line.'), rows: 1
                            } %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="card mt-3 rounded-0 border-primary">
    <div class="card-body py-3 d-flex align-items-center justify-content-between gap-3">
        <div class="text-muted" style="font-size:0.875rem;">
            <i class="ti ti-info-circle me-1"></i>{{ trans('Generate a PDF preview of the selected format.') }}
        </div>
        <div class="d-flex flex-wrap justify-content-end gap-2 flex-shrink-0">
            <a href="{{ preview_pri }}" target="_blank"
               class="btn btn-primary d-flex align-items-center gap-2">
                <i class="ti ti-file-text"></i> {{ trans('Vista previa de responsiva') }}
            </a>
            {% if config.pri_enable_visual_inspection is defined and config.pri_enable_visual_inspection == 1 %}
                <a href="{{ preview_pri_inspection }}" target="_blank"
                   class="btn btn-primary d-flex align-items-center gap-2">
                    <i class="ti ti-map-pin"></i> {{ trans('Vista previa de inspección visual') }}
                </a>
            {% endif %}
            {% if config.pri_enable_return_form is defined and config.pri_enable_return_form == 1 %}
                <a href="{{ preview_pri_return }}" target="_blank"
                   class="btn btn-primary d-flex align-items-center gap-2">
                    <i class="ti ti-package-export"></i> {{ trans('Vista previa de devolución') }}
                </a>
            {% endif %}
        </div>
    </div>
</div>
