{# ── Plugin version / GitHub releases ───────────────────── #}
<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-brand-github', title: trans('Plugin version')} %}
    <div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="text-muted small">{{ trans('Installed version') }}</span>
            <span class="badge bg-blue-lt text-blue">v{{ currentPluginVersion }}</span>

            <span class="text-muted small ms-md-2">{{ trans('Latest version on GitHub') }}</span>
            {% if latestReleaseVersion %}
                <span class="badge {{ updateAvailable ? 'bg-yellow-lt text-yellow' : 'bg-green-lt text-green' }}">v{{ latestReleaseVersion }}</span>
            {% else %}
                <span class="badge bg-secondary-lt">{{ trans('Not available') }}</span>
            {% endif %}

            <a class="btn btn-sm btn-outline-primary ms-md-auto d-inline-flex align-items-center gap-1"
               href="https://github.com/monta990/responsivas/releases" target="_blank" rel="noopener noreferrer">
                <i class="ti ti-external-link"></i>{{ trans('Releases') }}
            </a>
        </div>

        {% if updateAvailable %}
            <div class="alert alert-warning py-2 px-3 mt-2 mb-0 d-flex align-items-center">
                <i class="ti ti-alert-triangle me-2"></i>
                <div>{{ trans('A new version is available on GitHub: %s')|format(latestReleaseVersion) }}</div>
            </div>
        {% elseif not latestReleaseVersion %}
            <div class="text-muted small mt-2 d-flex align-items-center">
                <i class="ti ti-cloud-off me-1"></i>
                <span>{{ trans('Could not check the latest version on GitHub.') }}</span>
            </div>
        {% endif %}
    </div>
</div>

{# ── Sub-card: configuration backup ─────────────────────── #}
<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-database-export', title: trans('Configuration backup') } %}
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <div class="fw-bold mb-1"><i class="ti ti-download me-1"></i>{{ trans('Export configuration') }}</div>
                <div class="form-text">{{ trans('Export Responsivas settings and the current logo to a JSON backup file.') }}</div>
                <button type="submit" name="export_config" value="1" class="btn btn-outline-primary mt-2">
                    <i class="ti ti-download me-1"></i>{{ trans('Export configuration') }}
                </button>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold" for="responsivas_config_file">
                    <i class="ti ti-upload me-1"></i>{{ trans('Import configuration') }}
                </label>
                <input type="file" class="form-control" id="responsivas_config_file" name="config_file" accept=".json,application/json">
                <div class="form-text">{{ trans('Import a Responsivas JSON backup. Existing settings are replaced by the values in the backup. Invalid user or phone-type references are skipped so the target installation keeps its current valid selection.') }}</div>
                <button type="submit" name="import_config" value="1" class="btn btn-outline-secondary mt-2">
                    <i class="ti ti-upload me-1"></i>{{ trans('Import configuration') }}
                </button>
            </div>
        </div>
        <div class="alert alert-info mt-3 mb-0 py-2">
            <i class="ti ti-info-circle me-1"></i>
            {{ trans('The export includes templates, document options, email settings, footer settings, and the logo. User and phone-type selections are only portable when their IDs exist in the target GLPI installation.') }}
        </div>
    </div>
</div>

{# ── Sub-card: document options ─────────────────────────── #}
<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-file-settings', title: trans('Responsibility document options')} %}
    <div class="card-body">
        {# Timezone #}
        <div class="mb-4">
            <label class="form-label fw-bold d-flex align-items-center mb-2" for="timezone">
                <i class="ti ti-world me-2"></i>
                <span>{{ trans('Timezone for PDFs') }}</span>
            </label>
            <div class="input-group">
                <span class="input-group-text"><i class="ti ti-clock" aria-hidden="true"></i></span>
                <select id="timezone" name="timezone" class="form-select">
                    {% for tz in timezone_list %}
                        <option value="{{ tz }}"{{ tz == config.timezone ? ' selected' : '' }}>{{ tz }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-text">
                {{ trans('This timezone will be used to display dates and times in PDFs. At plugin installation it defaults to the server timezone. More information at: %s')|replace({'%s': '<a href="https://www.php.net/manual/timezones.php" target="_blank" rel="noopener noreferrer">' ~ trans('PHP timezone list') ~ '</a>'})|raw }}
            </div>
        </div>

        {# Switches row #}
        <div class="mb-4">
            <div class="row">
                {% set switches = [
                    {name: 'show_employee_number', icon: 'ti-id-badge',   label: trans('Show employee number'),  body: trans('Show employee number in the responsibility document')},
                    {name: 'show_qr',              icon: 'ti-qrcode',     label: trans('Show QR'),               body: trans('Show QR with asset URL in responsibility document')},
                    {name: 'pdf_compression',      icon: 'ti-file-zip',   label: trans('Compress PDF'),          body: trans('Compress the generated PDF file')},
                    {name: 'pdf_protection',       icon: 'ti-lock',       label: trans('Protect PDF'),           body: trans('Restrict PDF copying and editing')}
                ] %}
                {% for sw in switches %}
                <div class="col-md-6">
                    <div class="form-label fw-bold d-flex align-items-center">
                        <i class="ti {{ sw.icon }} me-2"></i>{{ sw.label }}
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               id="{{ sw.name }}" name="{{ sw.name }}" value="1"
                               {{ attribute(config, sw.name) ? 'checked' : '' }}>
                        <label class="form-check-label" for="{{ sw.name }}">{{ sw.body }}</label>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# Watermark #}
        <div class="row mt-3">
            <div class="col-md-8">
                <label class="form-label fw-bold d-flex align-items-center" for="watermark_text">
                    <i class="ti ti-watermark me-2"></i>{{ trans('Watermark text') }}
                </label>
                <div class="input-group">
                    <span class="input-group-text"><i class="ti ti-eye"></i></span>
                    <input type="text" class="form-control" id="watermark_text" name="watermark_text" maxlength="40"
                           placeholder="{{ trans('PREVIEW') }}" value="{{ config.watermark_text ?? '' }}">
                </div>
                <div class="form-text">{{ trans('Diagonal text shown on previews. Leave empty for the default.') }}</div>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold d-flex align-items-center" for="watermark_opacity">
                    <i class="ti ti-adjustments me-2"></i>{{ trans('Watermark opacity (%)') }}
                </label>
                <div class="input-group">
                    <span class="input-group-text"><i class="ti ti-percentage"></i></span>
                    <input type="number" class="form-control" id="watermark_opacity" name="watermark_opacity"
                           min="5" max="100" step="5" value="{{ config.watermark_opacity ?? 25 }}">
                </div>
                <div class="form-text">{{ trans('5–100. Default: 25.') }}</div>
            </div>
        </div>

        {# Company name #}
        <div class="mb-4">
            <label class="form-label fw-bold" for="company_name">
                <i class="ti ti-briefcase me-2"></i>{{ trans('Company name in responsibility documents') }}
            </label>
            <div class="input-group">
                <span class="input-group-text"><i class="ti ti-building" aria-hidden="true"></i></span>
                <input type="text" id="company_name" name="company_name" class="form-control"
                       value="{{ config.company_name ?? '' }}" required>
            </div>
            <div class="form-text">{{ trans('This name will appear in the responsibility document text.') }}</div>
        </div>

        {# Currency #}
        <div class="mb-3">
            <label class="form-label fw-bold" for="currency">
                <i class="ti ti-currency-dollar me-1"></i>{{ trans('Currency symbol') }}
            </label>
            <div class="input-group" style="max-width:200px;">
                <span class="input-group-text"><i class="ti ti-coin" aria-hidden="true"></i></span>
                <input type="text" id="currency" name="currency" class="form-control" maxlength="10"
                       placeholder="$" value="{{ config.currency ?? '$' }}">
            </div>
            <div class="form-text">{{ trans('Symbol or code that appears before the price in phone loan agreements (e.g.: $, USD, MXN, €).') }}</div>
        </div>

        {# Witnesses #}
        <div class="mb-2">
            <div class="form-label fw-bold">
                <i class="ti ti-users me-1"></i>{{ trans('Witnesses for phone loan agreements') }}
            </div>
            <div class="form-text mb-3">{{ trans('Select two witnesses for the phone loan agreement.') }}</div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-label"><i class="ti ti-user me-1"></i>{{ trans('Witness 1') }}</div>
                    {{ widget_testigo1|raw }}
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-label"><i class="ti ti-user me-1"></i>{{ trans('Witness 2') }}</div>
                    {{ widget_testigo2|raw }}
                </div>
            </div>
        </div>

        {# Legal representative #}
        <div class="mb-2">
            <div class="form-label fw-bold">
                <i class="ti ti-user-shield me-1"></i>{{ trans('Legal representative for phone loan agreements') }}
            </div>
            <div class="form-text mb-3">{{ trans('Select the legal representative for the phone loan agreement.') }}</div>
            <div class="mb-3">
                <div class="form-label"><i class="ti ti-user me-1"></i>{{ trans('Legal representative') }}</div>
                {{ widget_representante|raw }}
            </div>
        </div>

    </div>
</div>

{# ── Sub-card: logo ──────────────────────────────────────── #}
<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-photo', title: trans('Institutional logo')} %}
    <div class="card-body">
        {% if not has_logo %}
            <div class="alert alert-warning d-flex align-items-start mb-4">
                <i class="ti ti-alert-triangle me-2 mt-1 text-warning" aria-hidden="true"></i>
                <div>
                    <strong>{{ trans('No logo configured.') }}</strong><br>
                    {{ trans('PDFs will be generated without a logo.') }}
                </div>
            </div>
        {% endif %}

        <div class="row">
            <div class="col-md-6">
                {% if has_logo %}
                    <div class="mb-4">
                        <div class="form-text mb-1">{{ trans('Click the image to download a backup copy.') }}</div>
                        <div class="form-label fw-bold d-flex align-items-center">
                            <i class="ti ti-photo-check me-2" aria-hidden="true"></i>
                            <span>{{ trans('Current logo') }}</span>
                        </div>
                        <a href="{{ logo_url }}" download="logo.png" title="{{ trans('Download logo') }}">
                            <img src="{{ logo_url_cached }}" class="img-fluid"
                                 style="max-height:80px;padding:8px;border-radius:6px;border:1px solid var(--tblr-border-color);cursor:pointer">
                        </a>
                        <div class="form-text mt-1">
                            {{ trans('Preview dimensions: ') }}{{ logo_width }} × {{ logo_height }} px · {{ trans('Size: ') }}<strong>{{ logo_size_kb }} KB</strong>
                        </div>
                        <div class="mt-3">
                            <button type="button" class="btn btn-danger d-flex align-items-center gap-2"
                                    data-bs-toggle="modal" data-bs-target="#deleteLogoModal">
                                <i class="ti ti-trash"></i> {{ trans('Delete current logo') }}
                            </button>
                        </div>
                    </div>
                {% endif %}
            </div>
            <div class="col-md-6">
                <div class="mb-4">
                    <div class="form-label fw-bold d-flex align-items-center">
                        <i class="ti ti-eye me-2" aria-hidden="true"></i>
                        <span>{{ trans('Preview') }}</span>
                    </div>
                    <img id="logo-preview" class="img-fluid d-none"
                         style="max-height:80px;padding:8px;border-radius:6px;border:1px dashed var(--tblr-border-color)">
                    <div id="preview-size" class="form-text d-none mt-1"></div>
                    <div class="form-text mb-1">{{ trans('Load an image for a preview.') }}</div>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold d-flex align-items-center" for="responsivas_logo_input">
                <i class="ti ti-upload me-2" aria-hidden="true"></i>
                <span>{{ trans('Upload new logo') }}</span>
            </label>
            <input type="file" name="logo" class="form-control mt-1"
                   accept="image/png,image/jpeg" id="responsivas_logo_input">
            <div class="form-text">{{ trans('PNG / JPG · Max 500 KB · Will be saved as <b>logo.png</b>.')|raw }}</div>
        </div>
        <div class="form-text mb-1">
            {{ trans('Once loaded and validated in preview, remember to save for it to take effect.') }}
        </div>

    </div>
</div>
