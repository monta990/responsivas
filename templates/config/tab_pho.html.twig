<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-device-mobile', title: trans('Phone responsibility document settings')} %}
    <div class="card-body">

        <div class="row mt-3">
            <div class="col-md-6 mb-3">
                <div class="form-label fw-bold d-flex align-items-center gap-1">
                    <i class="ti ti-list-details"></i> {{ trans('Phone type for responsibility') }}
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="ti ti-device-mobile"></i></span>
                    <div class="flex-grow-1">{{ widget_phone_type|raw }}</div>
                </div>
                <div class="form-text">{{ trans('Select the phone type that will be considered for generating responsibility documents.') }}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold d-flex align-items-center gap-1" for="pho_font_size">
                    <i class="ti ti-arrows-vertical"></i> {{ trans('Font size (pt)') }}
                </label>
                <div class="input-group">
                    <span class="input-group-text"><i class="ti ti-text-size"></i></span>
                    <input type="number" class="form-control" id="pho_font_size" name="pho_font_size"
                           value="{{ config.pho_font_size ?? 9 }}" min="6" max="24">
                </div>
                <div class="form-text">{{ trans('Enter the font size for the PDF') }}</div>
            </div>
        </div>

        <div class="row">
            {% include 'partials/footer_fields.html.twig' with {prefix: 'pho', config: config} %}
        </div>

    </div>
</div>


<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-file-text', title: trans('Document template')} %}
    <div class="card-body">

        {% include 'partials/variable_hints.html.twig' with {vars: {
            '{nombre}':             trans('User name'),
            '{empresa}':            trans('Company'),
            '{num_empleado}':       trans('Employee number'),
            '{activo}':             trans('Asset number'),
            '{serie_uuid}':         trans('UUID / Serial'),
            '{imei}':               trans('IMEI'),
            '{marca}':              trans('Brand'),
            '{modelo}':             trans('Model'),
            '{estado}':             trans('Condition'),
            '{precio}':             trans('Purchase price'),
            '{linea}':              trans('Line / mobile number'),
            '{ram}':                trans('RAM'),
            '{almacenamiento}':     trans('Storage'),
            '{fecha}':              trans('Document date'),
            '{hora}':               trans('Document time'),
            '{lugar}':              trans('City, State, Country'),
            '{direccion}':          trans('Entity address'),
            '{cp}':                 trans('ZIP / Postal code'),
            '{representante}':      trans('Representative name'),
            '{testigo1}':           trans('Witness 1'),
            '{testigo2}':           trans('Witness 2'),
            '{clausula_vida_util}': trans('Useful life clause (auto-generated)')
        }} %}

        {% include 'partials/template_editor.html.twig' with {
            label: trans('Document title'), name: 'pho_titulo',
            value: pho_titulo_v, hint: trans('Contract heading. Use **text** for bold.'), rows: 1
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Opening paragraph'), name: 'pho_apertura',
            value: pho_apertura_v, hint: trans('Appearance paragraph before the clauses. Use **text** for bold.'), rows: 4
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Clauses'), name: 'pho_clausulas',
            value: pho_clausulas_v, hint: trans('One clause per line with format "1. text". Use {clausula_vida_util} for the useful life clause. **text** → bold.'), rows: 15
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Witnesses paragraph'), name: 'pho_testigos',
            value: pho_testigos_v, hint: trans('Witnesses appearance text. Use **text** for bold.'), rows: 3
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Useful life clause (with invoice)'), name: 'pho_vida_util_factura',
            value: pho_vida_util_factura_v, hint: trans('Used when the phone has an invoice and supplier. Variables: {fecha_compra}, {factura}, {proveedor}. Empty uses the default text.'), rows: 2
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Useful life clause (without invoice)'), name: 'pho_vida_util_sin',
            value: pho_vida_util_sin_v, hint: trans('Used when the phone has no registered invoice or supplier. Empty uses the default text.'), rows: 2
        } %}

    </div>
</div>

<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-clipboard-text', title: trans('Inspection and return form templates') } %}
    <div class="card-body">
        <div class="fw-bold mb-2 d-flex align-items-center gap-2">
            <i class="ti ti-clipboard-check"></i>{{ trans('Manual forms') }}
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pho_enable_visual_inspection" name="pho_enable_visual_inspection" value="1" {{ config.pho_enable_visual_inspection ? 'checked' : '' }}>
                    <label class="form-check-label fw-bold" for="pho_enable_visual_inspection">{{ trans('Enable visual inspection form') }}</label>
                </div>
                <div class="form-text">{{ trans('Shows the Visual condition button below Phones. The PDF is fixed and designed to be completed by hand.') }}</div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="pho_enable_return_form" name="pho_enable_return_form" value="1" {{ config.pho_enable_return_form ? 'checked' : '' }}>
                    <label class="form-check-label fw-bold" for="pho_enable_return_form">{{ trans('Enable return form') }}</label>
                </div>
                <div class="form-text">{{ trans('Shows the Return button below Phones. The PDF is fixed and designed to be completed by hand.') }}</div>
            </div>
        </div>

        <hr class="my-3">

        <div class="fw-bold mb-3 d-flex align-items-center gap-2">
            <i class="ti ti-file-text"></i>{{ trans('Manual form templates') }}
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <h5 class="mb-3">{{ trans('Visual condition form') }}</h5>
                {% include 'partials/template_editor.html.twig' with {
                    label: trans('Title'), name: 'pho_inspection_title',
                    value: config.pho_inspection_title,
                    hint: trans('Title printed in the fixed manual PDF.'), rows: 1
                } %}
                {% include 'partials/template_editor.html.twig' with {
                    label: trans('Instructions'), name: 'pho_inspection_instructions',
                    value: config.pho_inspection_instructions,
                    hint: trans('Text printed above the handwritten observation area. Use **text** for bold.'), rows: 4
                } %}
                <div class="mt-3 pt-3 border-top">
                    <div class="fw-bold mb-2">{{ trans('Document footer') }}</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Top left'), name: 'pho_inspection_footer_left_1',
                                value: config.pho_inspection_footer_left_1,
                                hint: trans('Upper-left footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Top right'), name: 'pho_inspection_footer_right_1',
                                value: config.pho_inspection_footer_right_1,
                                hint: trans('Upper-right footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Bottom left'), name: 'pho_inspection_footer_left_2',
                                value: config.pho_inspection_footer_left_2,
                                hint: trans('Lower-left footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Bottom right'), name: 'pho_inspection_footer_right_2',
                                value: config.pho_inspection_footer_right_2,
                                hint: trans('Lower-right footer line.'), rows: 1
                            } %}
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-lg-6">
                <h5 class="mb-3">{{ trans('Return form') }}</h5>
                {% include 'partials/template_editor.html.twig' with {
                    label: trans('Title'), name: 'pho_return_title',
                    value: config.pho_return_title,
                    hint: trans('Title printed in the fixed manual PDF.'), rows: 1
                } %}
                {% include 'partials/template_editor.html.twig' with {
                    label: trans('Instructions'), name: 'pho_return_instructions',
                    value: config.pho_return_instructions,
                    hint: trans('Text printed above the handwritten observation area. Use **text** for bold.'), rows: 4
                } %}
                <div class="mt-3 pt-3 border-top">
                    <div class="fw-bold mb-2">{{ trans('Document footer') }}</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Top left'), name: 'pho_return_footer_left_1',
                                value: config.pho_return_footer_left_1,
                                hint: trans('Upper-left footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Top right'), name: 'pho_return_footer_right_1',
                                value: config.pho_return_footer_right_1,
                                hint: trans('Upper-right footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Bottom left'), name: 'pho_return_footer_left_2',
                                value: config.pho_return_footer_left_2,
                                hint: trans('Lower-left footer line.'), rows: 1
                            } %}
                        </div>
                        <div class="col-md-6">
                            {% include 'partials/template_editor.html.twig' with {
                                label: trans('Bottom right'), name: 'pho_return_footer_right_2',
                                value: config.pho_return_footer_right_2,
                                hint: trans('Lower-right footer line.'), rows: 1
                            } %}
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="card mt-3 rounded-0 border-primary">
    <div class="card-body py-3 d-flex align-items-center justify-content-between gap-3">
        <div class="text-muted" style="font-size:0.875rem;">
            <i class="ti ti-info-circle me-1"></i>{{ trans('Generate a PDF preview of the selected format.') }}
        </div>
        <div class="d-flex flex-wrap justify-content-end gap-2 flex-shrink-0">
            <a href="{{ preview_pho }}" target="_blank"
               class="btn btn-primary d-flex align-items-center gap-2">
                <i class="ti ti-file-text"></i> {{ trans('Vista previa de responsiva') }}
            </a>
            {% if config.pho_enable_visual_inspection is defined and config.pho_enable_visual_inspection == 1 %}
                <a href="{{ preview_pho_inspection }}" target="_blank"
                   class="btn btn-primary d-flex align-items-center gap-2">
                    <i class="ti ti-map-pin"></i> {{ trans('Vista previa de inspección visual') }}
                </a>
            {% endif %}
            {% if config.pho_enable_return_form is defined and config.pho_enable_return_form == 1 %}
                <a href="{{ preview_pho_return }}" target="_blank"
                   class="btn btn-primary d-flex align-items-center gap-2">
                    <i class="ti ti-package-export"></i> {{ trans('Vista previa de devolución') }}
                </a>
            {% endif %}
        </div>
    </div>
</div>
