<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-device-desktop', title: trans('Computer responsibility document settings')} %}
    <div class="card-body">

        <div class="row mt-3">
            <div class="col-md-6 mb-3">
                <div class="form-label fw-bold d-flex align-items-center gap-1">
                    <i class="ti ti-text-wrap"></i> {{ trans('Font used') }}
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="ti ti-typography"></i></span>
                    <input type="text" class="form-control bg-body text-body" value="{{ pdf_font }}" readonly>
                </div>
                <div class="form-text">{{ trans('Font used in PDFs, can be changed in GLPI settings') }}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold d-flex align-items-center gap-1" for="pc_font_size">
                    <i class="ti ti-arrows-vertical"></i> {{ trans('Font size (pt)') }}
                </label>
                <div class="input-group">
                    <span class="input-group-text"><i class="ti ti-text-size"></i></span>
                    <input type="number" class="form-control" id="pc_font_size" name="pc_font_size"
                           value="{{ config.pc_font_size ?? 10 }}" min="6" max="24">
                </div>
                <div class="form-text">{{ trans('Enter the font size for the PDF') }}</div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="form-label fw-bold d-flex align-items-center">
                <i class="ti ti-writing-sign me-2"></i>{{ trans('Show lender/borrower signatures') }}
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox"
                       id="pc_show_comodato_sigs" name="pc_show_comodato_sigs" value="1"
                       {{ config.pc_show_comodato_sigs ? 'checked' : '' }}>
                <label class="form-check-label" for="pc_show_comodato_sigs">
                    {{ trans('Show both lender and borrower signature lines in computer responsibility document') }}
                </label>
            </div>
            <div class="form-text">{{ trans('Uses the legal representative configured in General settings.') }}</div>
        </div>

        <div class="row">
            {% include 'partials/footer_fields.html.twig' with {prefix: 'pc', config: config} %}
        </div>

    </div>
</div>

<div class="card mt-2 rounded-0">
    {% include 'partials/ribbon_header.html.twig' with {icon: 'ti-file-text', title: trans('Document template')} %}
    <div class="card-body">

        {% include 'partials/variable_hints.html.twig' with {vars: {
            '{nombre}':       trans('Full name of the assigned user'),
            '{empresa}':      trans('Company'),
            '{num_empleado}': trans('Employee number'),
            '{activo}':       trans('Asset number'),
            '{serie}':        trans('Serial number'),
            '{marca}':        trans('Brand'),
            '{modelo}':       trans('Model'),
            '{tipo}':         trans('Equipment type'),
            '{estado}':       trans('Condition / Status'),
            '{fecha}':        trans('Document date'),
            '{lugar}':        trans('City, State, Country')
        }} %}

        {% include 'partials/template_editor.html.twig' with {
            label: trans('Document title'), name: 'pc_titulo',
            value: pc_titulo_v, hint: trans('Main heading text. Use **text** for bold.'), rows: 1
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Introduction paragraph'), name: 'pc_intro',
            value: pc_intro_v, hint: trans('Introductory paragraph before the table. Use **text** for bold.'), rows: 3
        } %}
        {% include 'partials/template_editor.html.twig' with {
            label: trans('Body / Clauses'), name: 'pc_cuerpo',
            value: pc_cuerpo_v, hint: trans('Legal text after the table. Lines with "1. text" → numbered list. Blank line → new paragraph. **text** → bold.'), rows: 10
        } %}

    </div>
</div>

<div class="card mt-3 rounded-0 border-primary">
    <div class="card-body py-3 d-flex align-items-center justify-content-between">
        <div class="text-muted" style="font-size:0.875rem;">
            <i class="ti ti-info-circle me-1"></i>{{ trans('Generates a PDF preview using current settings. A watermark is applied.') }}
        </div>
        <a href="{{ preview_pc }}" target="_blank" class="btn btn-primary d-flex align-items-center gap-2 ms-3 flex-shrink-0">
            <i class="ti ti-eye"></i> {{ trans('Preview') }}
        </a>
    </div>
</div>
